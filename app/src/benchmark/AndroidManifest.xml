<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true" />
        <receiver
            android:name="com.huangder.lumibooks.benchmark.ReaderBenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.huangder.lumibooks.benchmark.CLEAR_READER_CACHE" />
                <action android:name="com.huangder.lumibooks.benchmark.PREPARE_APP" />
                <action android:name="com.huangder.lumibooks.benchmark.RESET_READING_POSITION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
