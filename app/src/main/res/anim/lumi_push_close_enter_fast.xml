<?xml version="1.0" encoding="utf-8"?>
<!-- Previous page returns from its parked offset as the top page leaves. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="380"
    android:interpolator="@interpolator/lumi_push"
    android:shareInterpolator="true">
    <translate
        android:fromXDelta="-25%"
        android:toXDelta="0" />
</set>
